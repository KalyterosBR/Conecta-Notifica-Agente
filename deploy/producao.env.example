# Copie para deploy/producao.env (fora do git) e preencha.
DOMINIO=painel.conectapontoeacesso.com.br
EMAIL_TLS=conectapontoeacesso@gmail.com
# Hostname da própria VPS — o wildcard *.srvNNNNNN.hstgr.cloud já aponta para
# ela, então funciona mesmo quando o domínio próprio está interceptado.
DOMINIO_VPS=notifica.srv1172775.hstgr.cloud
# Rede docker onde o Traefik da VPS está — é por ela que ele alcança api e web.
#   docker inspect traefik-traefik-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
REDE_TRAEFIK=n8n-alcg_default
# Postgres externo. Use ?sslmode=require se houver TLS.
# postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
DATABASE_URL=
# openssl rand -hex 32
JWT_SECRET=
# Conta UAZAPI do SaaS (painel da uazapi > API). Sem elas, o painel da escola
# volta a pedir base_url + token na mão, em vez de mostrar o QR code.
UAZAPI_URL=https://conectapontoeacesso.uazapi.com
UAZAPI_ADMIN_TOKEN=
# Endereço público da API, usado no webhook de status da UAZAPI.
PUBLIC_API_URL=https://painel.conectapontoeacesso.com.br/api
# Alerta de agente mudo (worker). Recebe um POST JSON; o n8n desta VPS
# resolve o destino (e-mail, WhatsApp, Telegram) sem senha de SMTP aqui.
ALERTAS_WEBHOOK_URL=
# Minutos sem heartbeat para considerar o agente mudo (ele bate a cada 60s).
ALERTA_AGENTE_MINUTOS=20
