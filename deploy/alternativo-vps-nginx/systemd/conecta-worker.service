[Unit]
Description=Conecta Notifica — worker de envio (WhatsApp)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=conecta
Group=conecta
WorkingDirectory=/opt/conecta-notifica/apps/api
EnvironmentFile=/opt/conecta-notifica/api.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
