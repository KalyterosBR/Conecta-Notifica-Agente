# Conecta Notifica — API
DATABASE_URL="postgresql://conecta:conecta@localhost:5433/conecta_notifica"
# Sem REDIS_URL a fila de notificações vira no-op (útil em dev sem Redis).
REDIS_URL="redis://localhost:6379"
PORT=3001
# Assinatura dos tokens do painel — obrigatório em produção.
JWT_SECRET="troque-em-producao"
# Origens aceitas pelo painel (vazio = libera geral, só para dev).
# CORS_ORIGIN="https://notifica.conectapontoeacesso.com.br"

# Conta UAZAPI do SaaS: habilita o onboarding por QR code no painel (a API cria
# uma instância por escola). Sem elas, a escola precisa colar base_url + token.
UAZAPI_URL="https://free.uazapi.com"
UAZAPI_ADMIN_TOKEN=""
# Endereço público desta API — a UAZAPI chama de volta neste endereço para
# atualizar os status de entrega. Em dev, deixe vazio.
PUBLIC_API_URL=""

# Alerta de agente mudo: o worker manda um POST JSON para cá. Vazio = só log.
ALERTAS_WEBHOOK_URL=""
ALERTA_AGENTE_MINUTOS="20"
