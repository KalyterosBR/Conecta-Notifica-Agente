{
  "name": "@conecta/api",
  "version": "0.1.0",
  "private": true,
  "description": "Conecta Notifica — API (NestJS): recepção de eventos do agente, filas e provedores WhatsApp",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "worker:dev": "ts-node src/worker.ts",
    "worker": "node dist/worker.js",
    "db:dev": "node scripts/dev-db.js",
    "criar-escola": "ts-node scripts/criar-escola.ts",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "embedded-postgres": "^16.14.0-beta.17",
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
